{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "allow",
      "*apt-get*": "ask",
      "*apt install*": "ask",
      "*apt update*": "ask",
      "*dnf install*": "ask",
      "*yum install*": "ask",
      "*pacman*": "ask",
      "*brew install*": "ask",
      "*npm install*": "ask",
      "*npm i *": "ask",
      "*npx*": "ask",
      "*yarn add*": "ask",
      "*pnpm add*": "ask",
      "*pip install*": "ask",
      "*pip3 install*": "ask",
      "*cargo install*": "ask",
      "*go install*": "ask",
      "*gem install*": "ask",
      "*conda install*": "ask",
      "*choco install*": "ask",
      "*winget install*": "ask",
      "*scoop install*": "ask",
      "*docker pull*": "ask",
      "*git clone*": "ask",
      "*curl*": "ask",
      "*wget*": "ask",
      "*git config*": "ask",
      "*systemctl *": "ask",
      "*update-alternatives*": "ask",
      "*update-java-alternatives*": "ask",
      "*export *": "ask"
    }
  }
}