# =============================================================================
# Variables de entorno de MyRecipes API
# Copiar como referencia a la configuración de Dokploy (Settings > Environment)
# =============================================================================

# --- Base de datos (Supabase) ------------------------------------------------
# sslmode=require está fijado en la URL JDBC. Para Supabase se recomienda el
# pooler: DB_PORT=6543 (modo transacción) o DB_PORT=5432 (modo sesión).
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USERNAME=postgres
DB_PASSWORD=
# Pool de conexiones Hikari (Supabase conviene mantenerlo bajo)
DB_POOL_SIZE=5

# --- Seguridad ---------------------------------------------------------------
# Obligatorio: mínimo 32 bytes. Generar con: openssl rand -base64 48
JWT_SECRET=
# Expiración del token en milisegundos (por defecto 1 hora)
JWT_EXPIRATION=3600000

# --- CORS --------------------------------------------------------------------
# Origen del frontend, sin path ni barra final. Varias origins separadas por coma
CORS_ALLOWED_ORIGINS=https://sergiomsrs.github.io

# --- Logging -----------------------------------------------------------------
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO

# --- Rate limit en /api/auth/** ---------------------------------------------
RATE_LIMIT_AUTH_ENABLED=true
RATE_LIMIT_AUTH_LIMIT=10
RATE_LIMIT_AUTH_WINDOW_MS=60000
